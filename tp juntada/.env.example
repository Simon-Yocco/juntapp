# Copiá este archivo como .env y completá tus datos de MySQL.
# El .env NO se sube al repositorio.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
# La base se crea sola al iniciar si no existe
DB_NAME=juntapp

# Clave para firmar las sesiones. Poné cualquier texto largo y secreto.
JWT_SECRET=cambiá-esto-por-un-texto-largo-y-secreto
